# Origem do backend utilizada pelo proxy HTTP/Socket.IO no servidor de desenvolvimento.
VITE_BACKEND_URL=http://127.0.0.1:5000

# Opcional em produção: URL completa até /api/reaproveitafranca.
# Vazio usa /api/reaproveitafranca na mesma origem.
VITE_API_URL=

# Client ID OAuth público de Aplicativo da Web. Não use Client Secret no frontend.
VITE_GOOGLE_CLIENT_ID=
