{
  "rewrites": [
    {
      "source": "/api/:path*/",
      "destination": "https://backend-production-b9fab22d.up.railway.app/api/:path*/"
    },
    {
      "source": "/socket.io/",
      "destination": "https://backend-production-b9fab22d.up.railway.app/socket.io/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://backend-production-b9fab22d.up.railway.app/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://backend-production-b9fab22d.up.railway.app/socket.io/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
